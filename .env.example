# Copy to .env.local and fill in. See docs/spec.md §13.

# Canonical site URL (metadata, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Arcee chatbot (Groq). Without a key Arcee says it's offline.
GROQ_API_KEY=
ARCEE_MODEL=openai/gpt-oss-20b
# Set to 1 to use a local stand-in model (no key needed) for development.
ARCEE_MOCK=

# Rate limiting for Arcee (Upstash Redis via Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Leave-a-message emails (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a sender on a domain verified in Resend (defaults to Resend's onboarding sender)
CONTACT_FROM_EMAIL=

# Optional: higher GitHub API rate limit for the "currently building" feed
GITHUB_TOKEN=
